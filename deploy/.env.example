# copy to deploy/.env (gitignored) and edit
SITE_ADDRESS=:80                 # or your domain, e.g. fxradar.duckdns.org  -> automatic HTTPS
ANTHROPIC_API_KEY=               # optional (Advisor "ask the radar" via the LLM); leave empty for the template
FXRADAR_API_URL=                 # optional, e.g. http://serve:8080 if you also run the Rust service
