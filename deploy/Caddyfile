# Reverse proxy in front of the Streamlit app. SITE_ADDRESS comes from deploy/.env:
#   ":80"                    plain HTTP on the public IP (no domain yet)
#   "radar.example.com"      automatic HTTPS via Let's Encrypt (DNS A record must point at the VM)
{$SITE_ADDRESS}

encode zstd gzip
reverse_proxy app:8501           # websockets (Streamlit's transport) are proxied automatically
header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    -Server
}
