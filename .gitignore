# virtual environments
.venv/
venv/
env/

# python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# secrets — never committed (CLAUDE.md rule 9)
.streamlit/secrets.toml

# OS / editor
.DS_Store
.vscode/
.idea/

# NOTE: data/ and models/ are COMMITTED on purpose — the app reads artifacts,
# the pipeline writes them (CLAUDE.md rule 8). Do not ignore them.

# rust build artifacts
rust/**/target/

# arcade state store (sqlite) — user state, not an artifact
data/arcade.db

# production deploy (server-side only)
deploy/.env
deploy/refresh.log

# API key store (sha256 hashes + webhook secrets) — a secret file, never committed
data/keys.db
data/keys.db-wal
data/keys.db-shm

# prompt-pack source archives (contents already extracted into .claude/commands/)
/.claude.zip
/claude 2.zip
/.claude/commands.zip
