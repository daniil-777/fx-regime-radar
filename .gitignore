# virtual environments
.venv/
venv/
env/

# python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# secrets — never committed (CLAUDE.md rule 9)
.streamlit/secrets.toml

# OS / editor
.DS_Store
.vscode/
.idea/

# NOTE: data/ and models/ are COMMITTED on purpose — the app reads artifacts,
# the pipeline writes them (CLAUDE.md rule 8). Do not ignore them.

# rust build artifacts
rust/**/target/

# arcade state store (sqlite) — user state, not an artifact
data/arcade.db

# production deploy (server-side only)
deploy/.env
deploy/refresh.log

# API key store (sha256 hashes + webhook secrets) — a secret file, never committed
data/keys.db
data/keys.db-wal
data/keys.db-shm

# prompt-pack source archives (contents already extracted into .claude/commands/)
/.claude.zip
/claude 2.zip
/.claude/commands.zip
/0-45.zip
/.claude/commands/fxradar-direction-lab-32-34.zip
# ...and the pack's extracted folder: byte-identical copies of .claude/commands/phase-32..34
/.claude/commands/fxradar-direction-lab-32-34/

# local agent-tooling state (ruflo / claude-flow / agentdb) — machine-local, never an artifact
.claude-flow/
.swarm/
ruvector.db
agentdb.rvf
agentdb.rvf.lock
.claude/proven-config.json
.claude/.proven-config-version

# /brag launch-video renders (mp4 + composition, ~15 MB per run) — regenerated, not versioned
brag-output*/

# eval fixtures are committed; scratch reports are not
reports/eval_ci.md
